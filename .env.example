# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse_dev_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_URL is derived from REDIS_HOST/REDIS_PORT in config.py — no need to set it

# Backend
SECRET_KEY=ci-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=ci-jwt-secret-key-change-in-production-32c
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:3001"]
BASE_URL=http://localhost:8000

# Google OAuth (sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Google Drive OAuth (knowledge base integration)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Notion OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/api/v1/oauth/notion/callback

# Slack Bot OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_SCOPE=app_mentions:read,channels:history,chat:write,im:history,im:write

# Meta (WhatsApp / Messenger / Instagram)
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_MESSENGER_VERIFY_TOKEN=
META_INSTAGRAM_VERIFY_TOKEN=

# Shopify
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Zendesk
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=

# Dropbox
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# OpenAI (for embeddings and default LLM)
OPENAI_API_KEY=test

# Anthropic (optional)
ANTHROPIC_API_KEY=test

# Google AI (optional)
GOOGLE_AI_API_KEY=test

# OpenRouter (optional — used for autoconfig and internal LLM services)
OPENROUTER_API_KEY=

# Global AI proxy (optional — overrides default provider base URLs and API keys)
AI_BASE_URL=
AI_API_KEY=

# Encryption key for BYOK (base64-urlsafe 32-byte key; regenerate for production)
FERNET_KEY=dGVzdC1mZXJuZXQta2V5LWZvci1jaS1vbmx5LWNoYW5nZW1lPQ==

# Stripe (optional — billing features degrade gracefully without)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Deployment mode: set to true for PulseLite Cloud
CLOUD_MODE=false

# Frontend
VITE_API_URL=http://localhost:8000
# Note: Docker maps frontend container port 3000 → host port 3001
VITE_APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
