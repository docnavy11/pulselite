# === Required ===
SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-another-random-string

# Bootstrap admin (auto-created on first startup if no users exist)
ADMIN_EMAIL=test@pulse.dev
ADMIN_PASSWORD=test

# === AI Configuration ===
# Option 1: OpenRouter (recommended — one key for all models)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-...

# Option 2: Direct provider keys
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# Default models
DEFAULT_CHATBOT_MODEL=claude-haiku-4-5-20251001
INTERNAL_MODEL=claude-haiku-4-5-20251001

# === Database (defaults work with docker-compose) ===
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=pulse
# POSTGRES_USER=pulse
# POSTGRES_PASSWORD=pulse_dev_password

# === Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ===
FERNET_KEY=

# === OAuth (optional) ===
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# === Deployment ===
CLOUD_MODE=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
