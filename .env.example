# =============================================================================
# REQUIRED — the app will not start without these
# =============================================================================

# Database (defaults work with the bundled docker-compose postgres)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse_dev_password

# Redis (defaults work with the bundled docker-compose redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Security keys — CHANGE THESE in production (min 32 chars each)
SECRET_KEY=ci-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=ci-jwt-secret-key-change-in-production-32c

# Encryption key for stored API keys (base64-urlsafe 32-byte key; regenerate for production)
FERNET_KEY=dGVzdC1mZXJuZXQta2V5LWZvci1jaS1vbmx5LWNoYW5nZW1lPQ==

# Bootstrap admin account (auto-created on first startup if no users exist)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme

# =============================================================================
# AI CONFIGURATION — required for chatbots to work
# =============================================================================
# PulseLight needs an OpenRouter-compatible AI API to power chatbots.
# Set AI_API_KEY + AI_BASE_URL here, or configure per-workspace in Settings > AI Models.
#
# Fallback chain: workspace key (Settings > AI Models) → AI_API_KEY env var → chatbot won't work
#
# Examples:
#   OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1  AI_API_KEY=sk-or-v1-...
#   OpenAI:      AI_BASE_URL=https://api.openai.com/v1     AI_API_KEY=sk-...
#   Local LLM:   AI_BASE_URL=http://localhost:11434/v1      AI_API_KEY=ollama
AI_BASE_URL=
AI_API_KEY=

# Default model assigned to new chatbots (must be available from your AI provider)
# Example: openai/gpt-4o-mini, anthropic/claude-3-haiku, meta-llama/llama-3-8b
DEFAULT_CHATBOT_MODEL=

# Model used for background tasks (autoconfig, conversation analysis, Q&A generation)
INTERNAL_MODEL=

# =============================================================================
# OPTIONAL — legacy provider keys (only needed if NOT using AI_BASE_URL/AI_API_KEY)
# =============================================================================

# OpenAI (for embeddings and default LLM — leave empty if using AI_API_KEY above)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# =============================================================================
# OPTIONAL — integrations (leave empty to disable)
# =============================================================================

# Google OAuth (sign-in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Google Drive OAuth (knowledge base integration)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Notion OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/api/v1/oauth/notion/callback

# Slack Bot OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_SCOPE=app_mentions:read,channels:history,chat:write,im:history,im:write

# Meta (WhatsApp / Messenger / Instagram)
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_MESSENGER_VERIFY_TOKEN=
META_INSTAGRAM_VERIFY_TOKEN=

# Shopify
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Zendesk
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=

# Dropbox
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# =============================================================================
# OPTIONAL — billing & deployment
# =============================================================================

# Stripe (billing features degrade gracefully without)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Deployment mode: set to true for PulseLight Cloud (enables billing, credits, plan limits)
CLOUD_MODE=false

# =============================================================================
# OPTIONAL — performance tuning
# =============================================================================

# Number of background worker processes (each uses ~250MB RAM).
# Tasks are I/O-bound (LLM API calls, DB), so 2 is enough for most deployments.
# Increase to 4-8 if you run many concurrent crawl/ingestion jobs.
CELERY_WORKER_CONCURRENCY=2

# =============================================================================
# URLS — adjust if you change ports or use a reverse proxy
# =============================================================================

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# BACKEND_CORS_ORIGINS is auto-derived from FRONTEND_URL — only set manually if you
# need multiple origins (e.g. dev + staging). Format: ["http://host1","http://host2"]
# BACKEND_CORS_ORIGINS=
BASE_URL=http://localhost:8000

# Frontend URLs (Docker maps container port 3000 → host port 3001 by default)
# CORS is automatically derived from FRONTEND_URL — no need to set it separately.
VITE_API_URL=http://localhost:8000
VITE_APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
