# ── Stage 1: Build frontend ──────────────────────────────────────
FROM node:20-alpine AS frontend-build
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
# Default VITE_API_URL to same-origin (light mode serves everything on :8000)
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# ── Stage 2: Install Python dependencies ─────────────────────────
FROM python:3.12-slim AS python-deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ build-essential libffi-dev \
    && rm -rf /var/lib/apt/lists/*
RUN pip install uv
COPY backend/pyproject.toml backend/
# CPU-only PyTorch — saves ~6GB by excluding CUDA/nvidia/triton
RUN cd backend && uv pip install --system \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    --index-strategy unsafe-best-match \
    -e "." \
    && rm -rf /root/.cache/pip /root/.cache/uv /tmp/*

# ── Stage 3: Final image ─────────────────────────────────────────
FROM python:3.12-slim AS final
WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    redis-server supervisor postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy Python environment from stage 2
COPY --from=python-deps /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=python-deps /usr/local/bin /usr/local/bin

# Install Playwright browser + runtime deps in final stage
RUN playwright install chromium --with-deps

# Copy built frontend
COPY --from=frontend-build /app/frontend/dist /app/static

# Copy backend source and ensure it's on Python path
COPY backend/ /app/backend/
ENV PYTHONPATH=/app/backend

# Copy infra configs
COPY infra/light/ /app/infra/light/
COPY infra/postgres/init.sql /app/infra/postgres/init.sql

# Make entrypoint executable
RUN chmod +x /app/infra/light/entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["bash", "/app/infra/light/entrypoint.sh"]
